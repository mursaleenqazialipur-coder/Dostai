import os
import time
import streamlit as st
from google import genai
from google.genai import types

st.set_page_config(
    page_title="Dost AI",
    page_icon="🤖"
)

st.title("🤖 Dost AI")
st.write("Tumhara friendly AI dost — Urdu, Roman Urdu ya English mein baat karo.")

api_key = os.getenv("GEMINI_API_KEY")

if not api_key:
    st.error("GEMINI_API_KEY configure nahi hai.")
    st.stop()

client = genai.Client(api_key=api_key)

MODELS = [
    "gemini-3.5-flash",
    "gemini-3.1-flash-lite"
]

SYSTEM_PROMPT = """
Tumhara naam Dost AI hai.

Tum ek friendly aur intelligent AI assistant ho.

Agar user poochay tum kon ho, to jawab do:
"Main Dost AI hoon, tumhara AI dost."

User jis language mein baat kare, usi language mein jawab do.

Urdu, Roman Urdu aur English samjho.

Seedha, natural aur helpful jawab do.

Apni pehchan Gemini ya Google AI ke naam se mat batao.

User ki baat ka seedha jawab do.
Be-wajah ye mat kaho ke text mein likho.
"""


def ask_dost(user_text):
    contents = []

    for msg in st.session_state.messages[-10:]:
        contents.append({
            "role": msg["role"],
            "parts": [
                {"text": msg["content"]}
            ]
        })

    contents.append({
        "role": "user",
        "parts": [
            {"text": user_text}
        ]
    })

    last_error = None

    for model in MODELS:
        for attempt in range(2):
            try:
                response = client.models.generate_content(
                    model=model,
                    contents=contents,
                    config=types.GenerateContentConfig(
                        system_instruction=SYSTEM_PROMPT,
                        temperature=0.7,
                        max_output_tokens=1024
                    )
                )

                answer = (response.text or "").strip()

                if answer:
                    return answer

                last_error = "Dost AI ne khaali jawab diya."

            except Exception as e:
                last_error = str(e)
                time.sleep(2)

    raise Exception(last_error)


def transcribe_voice(audio):
    audio_data = audio.getvalue()

    if not audio_data:
        raise Exception("Audio recording empty hai.")

    audio_type = audio.type or "audio/wav"

    prompt = """
Is voice recording ko dhyan se suno.

Sirf user ki boli hui baat ko exact text mein likho.

Koi jawab mat do.
Koi explanation mat do.
Koi guess mat karo.

User jis language mein bola hai, usi language mein transcript do.

Agar kuch alfaaz clear na hon to un alfaaz ka andaza mat lagao.
Agar poori recording samajh na aaye to sirf:
[UNCLEAR]
likho.
"""

    contents = [
        {
            "role": "user",
            "parts": [
                {"text": prompt},
                types.Part.from_bytes(
                    data=audio_data,
                    mime_type=audio_type
                )
            ]
        }
    ]

    last_error = None

    for model in MODELS:
        for attempt in range(2):
            try:
                response = client.models.generate_content(
                    model=model,
                    contents=contents,
                    config=types.GenerateContentConfig(
                        temperature=0,
                        max_output_tokens=500
                    )
                )

                transcript = (response.text or "").strip()

                if transcript:
                    return transcript

                last_error = "Voice ka transcript khaali hai."

            except Exception as e:
                last_error = str(e)
                time.sleep(2)

    raise Exception(last_error)


