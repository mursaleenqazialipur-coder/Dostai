import os
import streamlit as st
from google import genai
from google.genai import types

# -----------------------------
# Page setup
# -----------------------------
st.set_page_config(
    page_title="Dost AI",
    page_icon="🤖",
    layout="centered"
)

st.title("🤖 Dost AI")
st.write("Tumhara friendly AI dost — Urdu, Roman Urdu ya English mein baat karo.")

# -----------------------------
# Gemini API
# -----------------------------
api_key = os.getenv("GEMINI_API_KEY")

if not api_key:
    st.error("GEMINI_API_KEY configure nahi hai.")
    st.stop()

client = genai.Client(api_key=api_key)

# -----------------------------
# Session memory
# Har user/session ki chat alag
# -----------------------------
if "messages" not in st.session_state:
    st.session_state.messages = []

# -----------------------------
# Dost AI personality
# -----------------------------
SYSTEM_INSTRUCTION = """
Tum Dost AI ho — ek friendly, helpful aur respectful AI dost.

Rules:
1. User jis language mein baat kare, usi language mein jawab do.
2. Roman Urdu ho to Roman Urdu mein jawab do.
3. Urdu ho to Urdu mein jawab do.
4. English ho to English mein jawab do.
5. User ke current conversation messages ko context ke taur par use karo.
6. Agar user pooche "main kon hoon?" ya "aap mere baare mein kya jaante ho?",
   to sirf wahi information batao jo user ne isi current conversation/session
   mein khud share ki ho.
7. Kisi doosre user ki information kabhi share mat karo.
8. Agar user ne apna naam nahi bataya, to naam guess mat karo.
9. Apne aap ko insaan mat batao. Tum Dost AI ho.
10. Short, natural aur friendly jawab do.
11. User se unnecessary personal information mat maango.
12. Fiverr, Upwork, Canva, CapCut ya earning ki lecture-type advice
    tab tak mat do jab tak user khud na pooche.
"""

# -----------------------------
# Previous chat display
# -----------------------------
for message in st.session_state.messages:
    with st.chat_message(message["role"]):
        st.markdown(message["content"])

# -----------------------------
# Voice input
# -----------------------------
st.subheader("🎙️ Voice message")

audio = st.audio_input(
    "🎙️ Voice se baat karein — bolo, Dost AI tumhari awaaz ko text mein badlega"
)

if audio is not None:
    try:
        audio_bytes = audio.getvalue()

        with st.spinner("Dost tumhari awaaz samajh raha hai..."):
            response = client.models.generate_content(
                model="gemini-2.5-flash",
                contents=[
                    types.Content(
                        role="user",
                        parts=[
                            types.Part.from_bytes(
                                data=audio_bytes,
                                mime_type=audio.type
                            ),
                            types.Part.from_text(
                                text=(
                                    "Is voice message ko samjho aur user ki baat ka "
                                    "seedha jawab do. User jis language mein bol raha "
                                    "hai, usi language mein jawab do."
                                )
                            )
                        ]
                    )
                ],
                config=types.GenerateContentConfig(
                    system_instruction=SYSTEM_INSTRUCTION
                )
            )

        answer = response.text

        st.session_state.messages.append(
            {"role": "user", "content": "🎙️ Voice message"}
        )

        st.session_state.messages.append(
            {"role": "assistant", "content": answer}
        )

        st.rerun()

    except Exception as e:
        st.error("Voice message process nahi ho saka.")
        st.caption(str(e))

# -----------------------------
# Text chat
# -----------------------------
user_input = st.chat_input("Dost se baat karo...")

if user_input:
    # User message save
    st.session_state.messages.append(
        {"role": "user", "content": user_input}
    )

    with st.chat_message("user"):
        st.markdown(user_input)

    # Conversation context
    conversation = []

    for message in st.session_state.messages:
        conversation.append(
            {
                "role": message["role"],
                "parts": [{"text": message["content"]}]
            }
        )

    try:
        with st.chat_message("assistant"):
            with st.spinner("Dost soch raha hai..."):

                response = client.models.generate_content(
                    model="gemini-2.5-flash",
                    contents=conversation,
                    config=types.GenerateContentConfig(
                        system_instruction=SYSTEM_INSTRUCTION
                    )
                )

                answer = response.text
                st.markdown(answer)

        st.session_state.messages.append(
            {"role": "assistant", "content": answer}
        )

    except Exception as e:
        st.error("Dost AI se response nahi aa saka.")
        st.caption(str(e))

