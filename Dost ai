
import os
import time
import streamlit as st
from google import genai
from google.genai import types

st.set_page_config(
    page_title="Dost AI",
    page_icon="🤖"
)

st.title("🤖 Dost AI")
st.write("Tumhara friendly AI dost — Urdu, Roman Urdu ya English mein baat karo.")

api_key = os.getenv("GEMINI_API_KEY")

if not api_key:
    st.error("GEMINI_API_KEY configure nahi hai.")
    st.stop()

client = genai.Client(api_key=api_key)

SYSTEM_PROMPT = """
Tumhara naam Dost AI hai.
Tum user ke friendly aur intelligent AI dost ho.

Agar koi poochay tum kon ho, to kaho:
Main Dost AI hoon, tumhara AI dost.

User jis language mein baat kare, usi language mein jawab do.
Urdu, Roman Urdu aur English samajho.
Jawab seedha, helpful aur asaan rakho.
Apni pehchan Gemini ya Google AI na batao.
"""

MODELS = [
    "gemini-3.5-flash",
    "gemini-3.1-flash-lite"
]

if "messages" not in st.session_state:
    st.session_state.messages = []

for message in st.session_state.messages:
    with st.chat_message(message["role"]):
        st.markdown(message["content"])


def ask_dost(user_input, audio=None):
    contents = []

    for msg in st.session_state.messages[-10:]:
        contents.append({
            "role": msg["role"],
            "parts": [{"text": msg["content"]}]
        })

    parts = [{"text": user_input}]

    if audio is not None:
        parts.append(
            types.Part.from_bytes(
                data=audio.getvalue(),
                mime_type=audio.type
            )
        )

    contents.append({
        "role": "user",
        "parts": parts
    })

    last_error = None

    for model in MODELS:
        for attempt in range(2):
            try:
                response = client.models.generate_content(
                    model=model,
                    contents=contents,
                    config=types.GenerateContentConfig(
                        system_instruction=SYSTEM_PROMPT,
                        temperature=0.7,
                        max_output_tokens=1024
                    )
                )

                if response.text:
                    return response.text

                last_error = "Model ne khaali jawab diya."

            except Exception as e:
                last_error = str(e)
                time.sleep(2)

    raise Exception(last_error)


# Recording system
st.subheader("🎙️ Dost se awaaz mein baat karein")

audio = st.audio_input("🎙️ Apni awaaz record karein")

if st.button("📤 Recording bhejein", use_container_width=True):

    if audio is None:
        st.warning("Pehle recording karein.")

    else:
        with st.spinner("Dost aapki recording sun raha hai..."):

            try:
                answer = ask_dost(
                    "User ki recording suno. Uski baat samjho aur seedha jawab do. Audio ko text mein likhne ki zaroorat nahi.",
                    audio
                )

                st.session_state.messages.append({
                    "role": "user",
                    "content": "🎙️ Aapki voice recording"
                })

                st.session_state.messages.append({
                    "role": "assistant",
                    "content": answer
                })

                st.rerun()

            except Exception as e:
                st.error(
                    "Dost AI server busy hai ya connection mein masla hai. Thori dair baad dobara koshish karein."
                )


# Text chat
user_text = st.chat_input("Dost se baat karo...")

if user_text:

    st.session_state.messages.append({
        "role": "user",
        "content": user_text
    })

    with st.chat_message("user"):
        st.markdown(user_text)

    with st.chat_message("assistant"):
        with st.spinner("Dost soch raha hai..."):

            try:
                answer = ask_dost(user_text)
                st.markdown(answer)

                st.session_state.messages.append({
                    "role": "assistant",
                    "content": answer
                })

            except Exception as e:
    st.error(f"Voice Error: {e}")
                    "Dost AI server busy hai. Thori dair baad dobara try karein."
                )
