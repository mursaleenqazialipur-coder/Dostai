import os
import streamlit as st
from google import genai
from google.genai import types

st.set_page_config(
    page_title="Dost AI",
    page_icon="🤖"
)

st.title("🤖 Dost AI")
st.write("Tumhara friendly AI dost — Urdu, Roman Urdu ya English mein baat karo.")

# Gemini API key
api_key = os.getenv("GEMINI_API_KEY")

if not api_key:
    st.error("GEMINI_API_KEY configure nahi hai.")
    st.stop()

client = genai.Client(api_key=api_key)

# Chat history
if "messages" not in st.session_state:
    st.session_state.messages = []

# Dost AI ka context + user profile
system_instruction = """
Tum Dost AI ho — user ke liye ek friendly AI dost.

Tum Urdu, Roman Urdu aur English mein baat kar sakte ho.
User jis language mein baat kare, usi language mein jawab do.

IMPORTANT:
Agar user pooche:
- "Kiya tum meri personal information jantay ho?"
- "Tum mere baare mein kya jantay ho?"
- "Meri information batao"
- ya isi tarah ka koi sawal,

to neeche di gayi USER PROFILE mein jo information available hai,
sirf wahi information batao.

USER PROFILE:
- Naam: Mursaleen Ali
- Kaam: Construction work
- Taleem: 12th / FA
- Dost AI project ka owner/developer: Mursaleen Ali

Privacy:
USER PROFILE ki information sirf tab use karo jab user apne
baare mein pooche ya sawal ka jawab dene ke liye zaroori ho.
Agar koi information USER PROFILE mein nahi hai to usay
khud se invent mat karo.
Kabhi yeh mat kehna ke tum user ke baare mein "kuch bhi nahi jaante"
jab USER PROFILE mein relevant information available ho.

Tum apne aap ko hamesha Dost AI ke naam se identify karo jab
user pooche ke tum kon ho.

Normal sawalon par unnecessary earning, Fiverr, Upwork, Canva,
CapCut ya freelancing ki advice mat do.

Jawab seedha, natural aur friendly rakho.
User ki personal information ko unnecessarily repeat mat karo.

Agar user pooche ke tum uski personal information kahan se jaante ho,
to batao ke woh information Dost AI ke profile/context mein di gayi hai.
"""

# Purani chat display
for message in st.session_state.messages:
    with st.chat_message(message["role"]):
        st.write(message["content"])


# Voice input
st.subheader("🎙️ Voice se baat karein")

audio = st.audio_input(
    "Bolo — Dost AI tumhari awaaz samjhega"
)

if audio is not None:
    try:
        audio_bytes = audio.getvalue()

        uploaded_file = client.files.upload(
            file=audio_bytes,
            config={"mime_type": audio.type}
        )

        with st.spinner("Dost AI sun raha hai..."):User ki personal information:

- Naam: Mursaleen Ali
- Education: 12th / FA
- Kaam: Construction work

In maloomat ko sirf tab use karo jab user apne baare mein pooche, jaise:
"mera naam kya hai?", "meri education kya hai?", "main kya kaam karta hoon?"
Agar user normal/general sawal kare to ye personal information khud se mention na karo.

Agar user pooche "Mera naam kya hai?" to jawab do:
"Tumhara naam Mursaleen Ali hai."

Agar user pooche "Meri education kya hai?" to jawab do:
"Tumhari education 12th / FA hai."

Agar user pooche "Main kya kaam karta hoon?" to jawab do:
"Tum construction work karte ho."

Personal information ke baare mein jawab dete waqt seedha aur simple jawab do.

            response = client.models.generate_content(
                model="gemini-3.8-flash",
                contents=[
                    types.Content(
                        role="user",
                        parts=[
                            types.Part.from_uri(
                                file_uri=uploaded_file.uri,
                                mime_type=uploaded_file.mime_type
                            ),
                            types.Part.from_text(
                                text="""
Is voice message ko samjho aur user ke sawal ka jawab do.

USER PROFILE aur Dost AI ke system instructions ko follow karo.

Agar user apni personal information ke baare mein pooche,
to available USER PROFILE ki information batao.

User jis language mein baat kare, usi language mein jawab do.
Seedha aur natural jawab do.
"""
                            )
                        ]
                    )
                ],
                config=types.GenerateContentConfig(
                    system_instruction=system_instruction
                )
            )

        answer = response.text

        st.session_state.messages.append(
            {"role": "user", "content": "🎙️ Voice message"}
        )

        st.session_state.messages.append(
            {"role": "assistant", "content": answer}
        )

        st.rerun()

    except Exception as e:
        st.error("Voice message process nahi ho saka.")
        st.code(str(e))


# Text chat
user_input = st.chat_input("Dost se baat karo...")

if user_input:

    st.session_state.messages.append(
        {"role": "user", "content": user_input}
    )

    with st.chat_message("user"):
        st.write(user_input)

    try:
        with st.chat_message("assistant"):
            with st.spinner("Dost soch raha hai..."):

                response = client.models.generate_content(
                    model="gemini-3.8-flash",
                    contents=user_input,
                    config=types.GenerateContentConfig(
                        system_instruction=system_instruction
                    )
                )

                answer = response.text
                st.write(answer)

        st.session_state.messages.append(
            {"role": "assistant", "content": answer}
        )

    except Exception as e:
        st.error("AI response nahi de saka.")
        st.code(str(e))
