import os
import streamlit as st
from google import genai
from google.genai import types

# -----------------------------
# Page setup
# -----------------------------
st.set_page_config(
    page_title="Dost AI",
    page_icon="🤖"
)

st.title("🤖 Dost AI")
st.write("Tumhara friendly AI dost — Urdu, Roman Urdu ya English mein baat karo.")

# -----------------------------
# Gemini API
# -----------------------------
api_key = os.getenv("GEMINI_API_KEY")

if not api_key:
    st.error("GEMINI_API_KEY configure nahi hai.")
    st.stop()

client = genai.Client(api_key=api_key)

MODEL = "gemini-3.5-flash"

# -----------------------------
# User profile
# -----------------------------
USER_PROFILE = """
User ki basic information:

- Naam: Mursaleen Ali
- Rehne ka ilaqa: Alipur, District Muzaffargarh, Pakistan
- Kaam: Construction work
- Taleem: 12th / FA

Important:
User ki personal information sirf tab mention karo jab sawaal us se related ho.
Agar user normal/general sawaal pooche to bina zarurat profile information mat batao.
"""

# -----------------------------
# Dost AI instructions
# -----------------------------
SYSTEM_INSTRUCTION = f"""
Tum Dost AI ho — user ke friendly AI dost.

Tumhara naam Dost AI hai.

Tum Urdu, Roman Urdu aur English samajhte ho.
User jis language mein baat kare, koshish karo usi language mein jawab do.

Jawab:
- Seedha aur natural do.
- User ke sawaal ka hi jawab do.
- Purane sawaal ka jawab naye sawaal mein mat ghusao.
- Agar user ne naya sawaal poocha hai to usay independent sawaal samjho,
  jab tak user khud purani baat continue na kare.
- Agar sawaal simple ho to simple jawab do.
- Be-wajah lambi explanation mat do.
- User ko Fiverr, Upwork, Canva, CapCut ya online earning ki lecture
  mat do jab tak user khud na pooche.

User ki profile:
{USER_PROFILE}

Profile information ko sirf relevant situation mein use karna.

Agar user pooche:
"tum kis ilaqay mein rehte ho?"
to apne AI hone ki baat batao:
"Main kisi physical ilaqay mein nahi rehta, kyunki main AI hoon."
User ka ilaqa tab batao jab user apne ilaqay ke baare mein pooche.

Kabhi bhi kisi purane message ka jawab dobara mat dena
jab tak user us message ko specifically continue na kare.
"""

# -----------------------------
# Session history
# -----------------------------
if "messages" not in st.session_state:
    st.session_state.messages = []

# -----------------------------
# Show chat history
# -----------------------------
for message in st.session_state.messages:
    with st.chat_message(message["role"]):
        st.markdown(message["content"])

# -----------------------------
# Generate answer
# -----------------------------
def ask_dost(user_text):
    try:
        contents = []

        # Sirf actual conversation history bhejo
        for msg in st.session_state.messages:
            contents.append(
                types.Content(
                    role=msg["role"],
                    parts=[types.Part(text=msg["content"])]
                )
            )

        # Current user message
        contents.append(
            types.Content(
                role="user",
                parts=[types.Part(text=user_text)]
            )
        )

        response = client.models.generate_content(
            model=MODEL,
            contents=contents,
            config=types.GenerateContentConfig(
                system_instruction=SYSTEM_INSTRUCTION,
                temperature=0.4
            )
        )

        return response.text

    except Exception as e:
        error_text = str(e)

        if "503" in error_text:
            return "AI server busy hai. Thori dair baad dobara try karein."

        if "429" in error_text:
            return "Abhi AI ki free limit temporarily complete ho gayi hai. Thori dair baad dobara try karein."

        if "404" in error_text:
            return "AI model available nahi hai. Model setting check karni hogi."

        return f"AI error: {error_text}"


# -----------------------------
# Text chat
# -----------------------------
user_input = st.chat_input("Dost se baat karo...")

if user_input:
    # User message
    st.session_state.messages.append({
        "role": "user",
        "content": user_input
    })

    with st.chat_message("user"):
        st.markdown(user_input)

    # AI response
    with st.chat_message("assistant"):
        with st.spinner("Dost soch raha hai..."):
            answer = ask_dost(user_input)

        st.markdown(answer)

    st.session_state.messages.append({
        "role": "assistant",
        "content": answer
    })

# -----------------------------
# Voice input
# -----------------------------
st.subheader("🎙️ Voice se baat karein")
st.write("Bolo — Dost AI tumhari awaaz ko text mein badlega")

audio = st.audio_input("🎙️ Voice message")

if audio is not None:

    try:
        audio_bytes = audio.getvalue()

        uploaded_file = client.files.upload(
            file=audio_bytes,
            config={"mime_type": audio.type}
        )

        voice_response = client.models.generate_content(
            model=MODEL,
            contents=[
                types.Content(
                    role="user",
                    parts=[
                        types.Part(
                            text="""
Is voice message ko samjho aur pehle us mein boli gayi
baat ko identify karo.

Phir user ke actual sawaal ka seedha jawab do.

Purane conversation ke kisi sawaal ka jawab dobara mat do.
""",
                        ),
                        types.Part(
                            file_data=types.FileData(
                                file_uri=uploaded_file.uri,
                                mime_type=uploaded_file.mime_type
                            )
                        )
                    ]
                )
            ],
            config=types.GenerateContentConfig(
                system_instruction=SYSTEM_INSTRUCTION,
                temperature=0.4
            )
        )

        answer = voice_response.text

        st.session_state.messages.append({
            "role": "user",
            "content": "🎙️ Voice message"
        })

        st.session_state.messages.append({
            "role": "assistant",
            "content": answer
        })

        st.rerun()

    except Exception as e:
        error_text = str(e)

        if "503" in error_text:
            st.error("AI server busy hai. Thori dair baad dobara try karein.")
        elif "429" in error_text:
            st.error("Abhi AI ki free limit complete ho gayi hai. Thori dair baad try karein.")
        else:
            st.error(f"Voice error: {error_text}")
