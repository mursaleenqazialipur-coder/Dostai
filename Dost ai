import os
import time
import streamlit as st
from google import genai
from google.genai import types

st.set_page_config(
    page_title="Dost AI",
    page_icon="🤖"
)

st.title("🤖 Dost AI")
st.write("Your Friendly AI Assistant")
st.caption("Chat in English, Urdu or Roman Urdu.")

api_key = os.getenv("GEMINI_API_KEY")

if not api_key:
    st.error("GEMINI_API_KEY configure nahi hai.")
    st.stop()

client = genai.Client(api_key=api_key)

SYSTEM_PROMPT = """
Tumhara naam Dost AI hai.
Tum ek friendly aur intelligent AI assistant ho.

Agar user poochay tum kon ho, to jawab do:
"Main Dost AI hoon, tumhara AI dost."

User jis language mein baat kare, usi language mein jawab do.
Urdu, Roman Urdu aur English samjho.
Seedha, natural aur helpful jawab do.

Apni pehchan Gemini ya Google AI ke naam se mat batao.
User ki voice recording mein jo baat kahi gayi ho, usay samjho
aur usi baat ka natural jawab do.
"""

MODELS = [
    "gemini-3.5-flash",
    "gemini-3.1-flash-lite"
]


def ask_dost(user_text, audio=None):

    contents = []

    # Previous conversation
    for msg in st.session_state.messages[-10:]:
        contents.append({
            "role": msg["role"],
            "parts": [
                {"text": msg["content"]}
            ]
        })

    parts = []

    if user_text:
        parts.append({
            "text": user_text
        })

    # Voice recording
    if audio is not None:
        parts.append(
            types.Part.from_bytes(
                data=audio.getvalue(),
                mime_type=audio.type
            )
        )

    contents.append({
        "role": "user",
        "parts": parts
    })

    last_error = None

    for model in MODELS:

        for attempt in range(2):

            try:
                response = client.models.generate_content(
                    model=model,
                    contents=contents,
                    config=types.GenerateContentConfig(
                        system_instruction=SYSTEM_PROMPT,
                        temperature=0.7,
                        max_output_tokens=1024
                    )
                )

                if response.text:
                    return response.text

                last_error = "Khaali jawab mila."

            except Exception as e:
                last_error = str(e)
                time.sleep(2)

    raise Exception(last_error)


# Conversation history
if "messages" not in st.session_state:
    st.session_state.messages = []


for message in st.session_state.messages:

    with st.chat_message(message["role"]):
        st.markdown(message["content"])


# =========================
# VOICE
# =========================

st.subheader("🎙️ Voice se baat karein")
st.write("Bolo — Dost AI tumhari awaaz samjhega.")

audio = st.audio_input(
    "🎙️ Apni awaaz record karein"
)


if st.button(
    "📤 Recording bhejein",
    use_container_width=True
):

    if audio is None:

        st.warning(
            "Pehle apni awaaz record karein."
        )

    else:

        with st.spinner(
            "🎙️ Dost AI aapki awaaz samajh raha hai..."
        ):

            try:

                answer = ask_dost(
                    "Is voice recording ko suno. "
                    "User ne jo baat kahi hai usay samjho "
                    "aur uska seedha natural jawab do.",
                    audio
                )

                # Show voice message
                st.session_state.messages.append({
                    "role": "user",
                    "content": "🎙️ Voice message"
                })

                # Show AI answer
                st.session_state.messages.append({
                    "role": "assistant",
                    "content": answer
                })

                st.rerun()

            except Exception:

                st.error(
                    "Dost AI abhi voice process nahi kar saka. "
                    "Thori dair baad dobara try karein."
                )


# =========================
# TEXT CHAT
# =========================

user_text = st.chat_input(
    "Dost se baat karo..."
)


if user_text:

    st.session_state.messages.append({
        "role": "user",
        "content": user_text
    })

    with st.chat_message("user"):
        st.markdown(user_text)

    with st.chat_message("assistant"):

        with st.spinner(
            "Dost soch raha hai..."
        ):

            try:

                answer = ask_dost(
                    user_text
                )

                st.markdown(answer)

                st.session_state.messages.append({
                    "role": "assistant",
                    "content": answer
                })

            except Exception:

                st.error(
                    "Dost AI server busy hai. "
                    "Thori dair baad dobara try karein."
                )
